# Gratis nyckel: skapa konto på brickset.com och hämta en nyckel på https://brickset.com/tools/webservices/requestkey
BRICKSET_API_KEY=
# Valfritt
PORT=3000
# Hur många år bakåt vi hämtar set från (set som utgår är oftast 1–4 år gamla)
YEARS_BACK=4
# Max antal sidor (anrop) per uppdatering – Brickset tillåter 100 getSets-anrop/dygn
MAX_PAGES=12
# Hur länge cachen gäller (timmar)
CACHE_HOURS=24
